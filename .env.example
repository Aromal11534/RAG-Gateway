# Generate independent values, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_API_KEY=replace_with_a_long_random_gateway_key
ADMIN_API_KEY=replace_with_a_different_long_random_admin_key
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Embeddings are generated by an ONNX mining model installed in Oracle.
EMBEDDING_PROVIDER=oracle
# Leave blank to auto-discover the first EMBEDDING model in USER_MINING_MODELS.
ORACLE_EMBEDDING_MODEL=
# Optional preferred shard, for example oracle_04. Other shards are tried on failure.
ORACLE_EMBEDDING_SHARD=oracle_04
EMBEDDING_DIMENSION=384
MAX_TOP_K=100
MAX_TEXT_LENGTH=100000
MAX_METADATA_BYTES=65536
MAX_REQUEST_BODY_BYTES=2000000
MAX_BATCH_SIZE=100
MAX_BATCH_CONCURRENCY=8
DEFAULT_CHUNK_SIZE=1200
DEFAULT_CHUNK_OVERLAP=200
MAX_DOCUMENT_CHUNKS=1000
SEARCH_CANDIDATE_MULTIPLIER=3

# Replicas are clamped to the number of configured shards.
REPLICATION_FACTOR=2
WRITE_QUORUM=1

# Zero disables the in-process limiter. Use a shared edge limiter for multi-replica deployments.
RATE_LIMIT_REQUESTS_PER_MINUTE=0

DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_INCREMENT=1
DB_POOL_WAIT_TIMEOUT_MS=5000
SHARD_QUERY_TIMEOUT_SECONDS=10
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30

# Oracle DB 1. Repeat the four variables with DB2 through DB6 as needed.
DB1_USER=VECTOR_APP
DB1_PASSWORD=replace_with_database_password
DB1_DSN=(description=(retry_count=3)(retry_delay=2)(address=(protocol=tcps)(port=1522)(host=adb.example.oraclecloud.com))(connect_data=(service_name=example_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
DB1_WEIGHT=1.0
